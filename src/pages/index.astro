---
/**
 * Curated public homepage rendered directly from BLOG_POSTS.
 *
 * @decision DEC-SR-001
 * @title Render public curated content through SSR
 * @status accepted
 * @rationale Admin changes must appear without a deployment. The Worker reads
 *   the canonical site-content and blog-preview helpers, and Astro escapes all
 *   configured plain text without a client content API or runtime fallback.
 *
 * @decision DEC-SR-004
 * @title Render Words and excerpts as plain text
 * @status accepted
 * @rationale Words preserve authored line breaks and the validated blog
 *   preview remains text-only; neither public surface accepts raw HTML.
 *
 * @decision DEC-SR-006
 * @title Progressively enhance the bounded server-rendered Words carousel
 * @status accepted
 * @rationale SSR exposes the first configured Word without JavaScript. A tiny
 *   local index toggles existing slides with accessible wraparound controls;
 *   it owns no content, persistence, URL state, timer, or network request.
 */

export const prerender = false;

import { env as cloudflareEnv } from "cloudflare:workers";
import type { Env } from "../lib/kv-store.ts";
import {
  bootstrapSiteContent,
  getLatestPublishedPostPreview,
} from "../lib/site-content.ts";

const env = cloudflareEnv as Env;
const [{ selectedWords, selectedProjects }, latestPost] = await Promise.all([
  bootstrapSiteContent(env),
  getLatestPublishedPostPreview(env),
]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="George Hyde — software engineer, projects, writing, and collected words."
    />
    <title>George Hyde</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="shell">
      <header class="intro">
        <div>
          <h1>George Hyde</h1>
          <p></p>
        </div>
        <nav aria-label="Primary navigation">
          <a href="/blog">Blog</a>
          <a
            href="https://github.com/georgehyde-dot"
            target="_blank"
            rel="noopener noreferrer"
          >GitHub</a>
          <a href="mailto:hello@georgehyde.dev">Email</a>
        </nav>
      </header>

      <div class="cards">
        <section class="card">
          <p class="eyebrow">Latest Blog Post</p>
          {
            latestPost ? (
              <a class="card-link" href={`/blog/${latestPost.slug}`}>
                <h2>{latestPost.title}</h2>
                <p class="excerpt">{latestPost.excerpt}</p>
                <span class="action">Read post <span aria-hidden="true">→</span></span>
              </a>
            ) : (
              <p class="empty">No published posts yet.</p>
            )
          }
        </section>

        <section class="card carousel-card" data-carousel data-carousel-label="Word">
          <div class="card-heading">
            <div><p class="eyebrow">Words I Like</p><a class="collection-link" href="/words">View all</a></div>
            <div class="carousel-controls">
              <button type="button" data-carousel-previous aria-label="Previous Word" disabled={selectedWords.length === 1}>←</button>
              <span data-carousel-status aria-live="polite" aria-atomic="true">Word 1 of {selectedWords.length}</span>
              <button type="button" data-carousel-next aria-label="Next Word" disabled={selectedWords.length === 1}>→</button>
            </div>
          </div>
          <div class="reading-viewport" data-carousel-viewport tabindex="0">
            {selectedWords.map((word, index) => (
              <figure data-carousel-slide hidden={index !== 0}>
                <h2>{word.title}</h2>
                <blockquote>{word.text}</blockquote>
                <figcaption>— {word.attribution}</figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section class="card carousel-card" data-carousel data-carousel-label="Project">
          <div class="card-heading">
            <div><p class="eyebrow">Featured Projects</p><a class="collection-link" href="/projects">View all</a></div>
            <div class="carousel-controls">
              <button type="button" data-carousel-previous aria-label="Previous Project" disabled={selectedProjects.length === 1}>←</button>
              <span data-carousel-status aria-live="polite" aria-atomic="true">Project 1 of {selectedProjects.length}</span>
              <button type="button" data-carousel-next aria-label="Next Project" disabled={selectedProjects.length === 1}>→</button>
            </div>
          </div>
          <div class="reading-viewport" data-carousel-viewport tabindex="0">
            {selectedProjects.map((project, index) => (
              <article data-carousel-slide hidden={index !== 0}>
                <h2>{project.title}</h2>
                <p class="body-copy">{project.description}</p>
                <a class="action" href={project.url} target="_blank" rel="noopener noreferrer">View project <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </section>
      </div>
    </main>

    <script is:inline>
      document.querySelectorAll("[data-carousel]").forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll("[data-carousel-slide]"));
        const viewport = carousel.querySelector("[data-carousel-viewport]");
        const previous = carousel.querySelector("[data-carousel-previous]");
        const next = carousel.querySelector("[data-carousel-next]");
        const status = carousel.querySelector("[data-carousel-status]");
        const label = carousel.dataset.carouselLabel;
        if (slides.length > 0 && viewport && previous && next && status && label) {
          let visibleIndex = 0;
          const show = (nextIndex) => {
            visibleIndex = (nextIndex + slides.length) % slides.length;
            slides.forEach((slide, index) => {
              slide.hidden = index !== visibleIndex;
            });
            viewport.scrollTop = 0;
            status.textContent = `${label} ${visibleIndex + 1} of ${slides.length}`;
          };
          const single = slides.length === 1;
          previous.disabled = single;
          next.disabled = single;
          previous.addEventListener("click", () => show(visibleIndex - 1));
          next.addEventListener("click", () => show(visibleIndex + 1));
          show(0);
        }
      });
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        color-scheme: dark;
        font-family: "Inter", system-ui, sans-serif;
        background: #09090b;
        color: #e4e4e7;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 15% 0%, rgba(74, 222, 128, 0.08), transparent 34rem),
          #09090b;
      }

      .shell {
        width: min(1040px, 100%);
        margin: 0 auto;
        padding: 5rem 2rem;
      }

      .intro {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 3rem;
      }

      h1, h2, p, blockquote { margin-top: 0; }

      h1 {
        margin-bottom: 0.35rem;
        color: #fafafa;
        font-size: clamp(2.5rem, 8vw, 4.75rem);
        line-height: 1;
        letter-spacing: -0.055em;
      }

      .intro p {
        margin-bottom: 0;
        color: #a1a1aa;
        font-size: 1rem;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      nav a, .action {
        color: #a1a1aa;
        font-size: 0.875rem;
        font-weight: 500;
      }

      nav a:hover, nav a:focus-visible, .card-link:hover .action,
      .card-link:focus-visible .action { color: #4ade80; }

      .cards {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
      }

      .card {
        min-width: 0;
        border: 1px solid #27272a;
        border-radius: 14px;
        background: rgba(18, 18, 20, 0.88);
        padding: 1.4rem;
      }

      .eyebrow {
        margin-bottom: 1rem;
        color: #71717a;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .card-link {
        display: block;
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

      .card-link:focus-visible {
        border-radius: 6px;
        outline: 2px solid #4ade80;
        outline-offset: 5px;
      }

      h2 {
        margin-bottom: 0.75rem;
        color: #f4f4f5;
        font-size: clamp(1.25rem, 4vw, 1.7rem);
        line-height: 1.25;
        letter-spacing: -0.025em;
        overflow-wrap: anywhere;
      }

      .body-copy, blockquote, .excerpt, .empty {
        color: #b4b4bb;
        line-height: 1.7;
        overflow-wrap: anywhere;
      }

      .body-copy { max-width: 78ch; }

      .card-heading, .carousel-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .card-heading .eyebrow { margin-bottom: .3rem; }

      .collection-link {
        color: #a1a1aa;
        font-size: 0.8rem;
      }

      .collection-link:hover, .collection-link:focus-visible { color: #4ade80; }

      .reading-viewport {
        height: 14rem;
        margin-top: 1rem;
        overflow: auto;
        overscroll-behavior: contain;
        padding-right: .5rem;
        scrollbar-gutter: stable;
      }

      figure { margin: 0; }

      [data-carousel-slide][hidden] { display: none; }

      blockquote {
        margin-bottom: 0.7rem;
        font-size: 1.05rem;
        white-space: pre-wrap;
      }

      figcaption {
        color: #81818a;
        overflow-wrap: anywhere;
      }

      .carousel-controls {
        justify-content: flex-end;
      }

      .carousel-controls button {
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid #3f3f46;
        border-radius: 999px;
        background: #18181b;
        color: #e4e4e7;
        cursor: pointer;
        font: inherit;
      }

      .carousel-controls button:hover:not(:disabled),
      .carousel-controls button:focus-visible { border-color: #4ade80; }

      .carousel-controls button:disabled { cursor: default; opacity: 0.35; }

      [data-carousel-status] {
        color: #71717a;
        font-size: 0.75rem;
      }

      .excerpt {
        display: -webkit-box;
        margin-bottom: 1.4rem;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
      }

      .action {
        display: inline-block;
        margin-top: 0.4rem;
        transition: color 150ms ease;
      }

      .empty { margin-bottom: 0; }

      @media (max-width: 680px) {
        .shell { padding: 2.5rem 1rem; }
        .intro {
          align-items: flex-start;
          flex-direction: column;
          margin-bottom: 2rem;
        }
        .card { padding: 1.15rem; }
        .reading-viewport { height: 16rem; }
        .card-heading { align-items: flex-start; }
        .carousel-controls { flex: 0 0 auto; }
      }
    </style>
  </body>
</html>
