---
/**
 * Server-rendered Words collection management.
 *
 * @decision DEC-SR-005A
 * @title Selection forms call the independent homepage selection action
 * @status accepted
 * @rationale The page reads aggregate state for display but sends selection,
 *   update, and delete forms to their canonical server mutation helpers.
 */

export const prerender = false;

import { env as cloudflareEnv } from "cloudflare:workers";
import type { Env } from "../../../lib/kv-store.ts";
import {
  bootstrapSiteContent,
  listWords,
  type WordEntry,
} from "../../../lib/site-content.ts";

const env = cloudflareEnv as Env;
let words: WordEntry[] = [];
let selectedWordId = "";
let error: string | null = null;

try {
  const content = await bootstrapSiteContent(env);
  selectedWordId = content.state.selection.selectedWordId;
  words = await listWords(env);
} catch (caught) {
  error = caught instanceof Error ? caught.message : "Failed to load Words.";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Words — Admin</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; padding: 2.5rem 2rem; background: #0a0a0a; color: #e5e5e5; font-family: Inter, system-ui, sans-serif; }
      main { width: min(860px, 100%); margin: 0 auto; }
      nav, .top, .actions { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
      nav { margin-bottom: 1.5rem; }
      .top { justify-content: space-between; margin-bottom: 1.5rem; }
      h1 { margin: 0; font-size: 1.6rem; }
      a { color: #a3a3a3; }
      .btn, button { border: 1px solid #333; border-radius: 6px; background: #171717; color: #e5e5e5; cursor: pointer; font: inherit; font-size: .85rem; padding: .5rem .85rem; text-decoration: none; }
      .primary { background: #4ade80; border-color: #4ade80; color: #08120b; font-weight: 600; }
      .danger { color: #fca5a5; border-color: #5f2525; }
      .selected { color: #4ade80; font-size: .75rem; font-weight: 700; text-transform: uppercase; }
      .list { display: grid; gap: 1rem; }
      article { background: #121212; border: 1px solid #292929; border-radius: 10px; padding: 1.25rem; }
      blockquote { margin: .8rem 0; color: #d4d4d4; white-space: pre-wrap; }
      .attribution, .source { color: #858585; font-size: .85rem; }
      .actions { margin-top: 1rem; }
      form { margin: 0; }
      .error { color: #fca5a5; }
      @media (max-width: 560px) { body { padding: 1.25rem 1rem; } .actions > * { flex: 1 1 auto; text-align: center; } }
    </style>
  </head>
  <body>
    <main>
      <nav>
        <a href="/admin">Admin</a>
        <a href="/admin/homepage">Homepage settings</a>
        <a href="/">Home</a>
      </nav>
      <div class="top">
        <h1>Words I Like</h1>
        <a class="btn primary" href="/admin/words/new">New Word</a>
      </div>

      {error ? <p class="error">{error}</p> : (
        <div class="list">
          {words.map((word) => (
            <article>
              {word.id === selectedWordId && <div class="selected">Selected for homepage</div>}
              <blockquote>{word.text}</blockquote>
              <div class="attribution">— {word.attribution}</div>
              {word.source && <a class="source" href={word.source} target="_blank" rel="noopener noreferrer">Source</a>}
              <div class="actions">
                <a class="btn" href={`/admin/words/${word.id}/edit`}>Edit</a>
                {word.id !== selectedWordId && (
                  <form method="POST" action="/admin/api/homepage">
                    <input type="hidden" name="_action" value="selection" />
                    <input type="hidden" name="selectedWordId" value={word.id} />
                    <button type="submit">Show on homepage</button>
                  </form>
                )}
                <form method="POST" action={`/admin/api/words/${word.id}`}>
                  <input type="hidden" name="_method" value="delete" />
                  <button type="submit" class="danger">Delete</button>
                </form>
              </div>
            </article>
          ))}
        </div>
      )}
    </main>
  </body>
</html>
