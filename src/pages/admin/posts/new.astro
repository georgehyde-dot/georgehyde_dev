---
/**
 * src/pages/admin/posts/new.astro — Admin: create a new blog post.
 *
 * SSR form page (prerender = false). Submits POST to /admin/api/posts.
 * The API route owns validation, stored-HTML policy, and owner authorization;
 * this page remains a minimal form surface for the single-author site.
 *
 * Client-side features (zero dependencies, vanilla JS only):
 *   - Slug auto-generation: title → lowercase-hyphenated slug, user can override
 *   - Rich-text body editor writes HTML into the existing form body field
 *
 * @decision DEC-EDITOR-004
 * @title Platform rich-text editor, zero dependencies
 * @status accepted
 * @rationale The authoring surface should provide formatting controls without
 *   changing the existing KV/API contract. See src/components/PostEditor.astro.
 */

export const prerender = false;

import PostEditor from "../../../components/PostEditor.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Post — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: #0a0a0a;
        color: #e5e5e5;
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
        padding: 2.5rem 2rem;
      }

      .container { max-width: 1100px; margin: 0 auto; }

      .back-link {
        color: #6b6b6b;
        text-decoration: none;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 1.5rem;
        transition: color 0.15s;
      }
      .back-link:hover { color: #e5e5e5; }

      h1 { font-size: 1.5rem; font-weight: 600; color: #f5f5f5; margin-bottom: 2rem; }

      .layout {
        display: block;
      }

      .form-section { display: flex; flex-direction: column; gap: 1.25rem; }

      .field { display: flex; flex-direction: column; gap: 0.4rem; }

      label {
        font-size: 0.75rem;
        font-weight: 500;
        color: #6b6b6b;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      input[type="text"] {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        color: #e5e5e5;
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.6rem 0.8rem;
        width: 100%;
        transition: border-color 0.15s;
      }
      input[type="text"]:focus {
        outline: none;
        border-color: #4ade80;
      }

      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .checkbox-row input[type="checkbox"] { width: 1rem; height: 1rem; accent-color: #4ade80; }
      .checkbox-row label {
        font-size: 0.875rem;
        text-transform: none;
        letter-spacing: normal;
        color: #a3a3a3;
      }

      .form-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

      button[type="submit"] {
        background: #4ade80;
        color: #0a0a0a;
        border: none;
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.55rem 1.4rem;
        cursor: pointer;
        transition: opacity 0.15s;
      }
      button[type="submit"]:hover { opacity: 0.85; }

      a.btn-cancel {
        display: inline-block;
        padding: 0.55rem 1.1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        color: #a3a3a3;
        border: 1px solid #2a2a2a;
        transition: opacity 0.15s;
      }
      a.btn-cancel:hover { opacity: 0.8; }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/admin/posts" class="back-link">← Posts</a>
      <h1>New Post</h1>

      <div class="layout">
        <form method="POST" action="/admin/api/posts" class="form-section">
          <div class="field">
            <label for="title">Title</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              autocomplete="off"
              placeholder="Post title"
            />
          </div>

          <div class="field">
            <label for="slug">Slug</label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              autocomplete="off"
              placeholder="url-safe-slug"
            />
          </div>

          <PostEditor />

          <div class="checkbox-row">
            <input type="checkbox" id="published" name="published" />
            <label for="published">Publish immediately</label>
          </div>

          <div class="form-actions">
            <button type="submit">Create post</button>
            <a href="/admin/posts" class="btn-cancel">Cancel</a>
          </div>
        </form>

      </div>
    </div>

    <script>
      // Slug auto-generation from title.
      const titleInput = document.getElementById('title');
      const slugInput  = document.getElementById('slug');

      let slugEdited = false;

      slugInput.addEventListener('input', () => { slugEdited = true; });

      titleInput.addEventListener('input', () => {
        if (!slugEdited) {
          slugInput.value = titleInput.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }
      });
    </script>
  </body>
</html>
