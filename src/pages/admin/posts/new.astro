---
/**
 * src/pages/admin/posts/new.astro — Admin: create a new blog post.
 *
 * SSR form page (prerender = false). Submits POST to /admin/api/posts.
 * The API route owns validation, stored-HTML policy, and owner authorization;
 * this page remains a minimal form surface for the single-author site.
 *
 * Client-side features (zero dependencies, vanilla JS only):
 *   - Slug auto-generation: title → lowercase-hyphenated slug, user can override
 *   - Rich-text body editor writes HTML into the existing form body field
 *
 * @decision DEC-EDITOR-004
 * @title Platform rich-text editor, zero dependencies
 * @status accepted
 * @rationale The authoring surface should provide formatting controls without
 *   changing the existing KV/API contract. See src/components/PostEditor.astro.
 *
 * @decision DEC-BE-003
 * @title First valid snapshot claims immutable identity
 * @status accepted
 * @rationale The shared editor owns draft creation and exposes the canonical
 *   update action; this form projects that action onto ordinary publication so
 *   draft and publish mutations keep one API-owned post identity.
 */

export const prerender = false;

import PostEditor from "../../../components/PostEditor.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Post — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: #0a0a0a;
        color: #e5e5e5;
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
        padding: 2.5rem 2rem;
      }

      .container { max-width: 1100px; margin: 0 auto; }

      .back-link {
        color: #6b6b6b;
        text-decoration: none;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 1.5rem;
        transition: color 0.15s;
      }
      .back-link:hover { color: #e5e5e5; }

      h1 { font-size: 1.5rem; font-weight: 600; color: #f5f5f5; margin-bottom: 2rem; }

      .layout {
        display: block;
      }

      .form-section { display: flex; flex-direction: column; gap: 1.25rem; }

      .field { display: flex; flex-direction: column; gap: 0.4rem; }

      label {
        font-size: 0.75rem;
        font-weight: 500;
        color: #6b6b6b;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      input[type="text"] {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        color: #e5e5e5;
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.6rem 0.8rem;
        width: 100%;
        transition: border-color 0.15s;
      }
      input[type="text"]:focus {
        outline: none;
        border-color: #4ade80;
      }

      .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .checkbox-row input[type="checkbox"] { width: 1rem; height: 1rem; accent-color: #4ade80; }
      .checkbox-row label {
        font-size: 0.875rem;
        text-transform: none;
        letter-spacing: normal;
        color: #a3a3a3;
      }

      .save-state {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem 0.9rem;
        min-height: 2.25rem;
      }

      .save-status {
        color: #737373;
        flex: 1 1 12rem;
        font-size: 0.8rem;
      }
      .save-status[data-state="saving"] { color: #facc15; }
      .save-status[data-state="saved"] { color: #4ade80; }
      .save-status[data-state="error"] { color: #f87171; }

      .form-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

      button {
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.55rem 1.1rem;
        transition: opacity 0.15s;
      }
      button:hover { opacity: 0.85; }
      button:focus-visible {
        outline: 2px solid #4ade80;
        outline-offset: 2px;
      }
      button:disabled { cursor: not-allowed; opacity: 0.55; }

      .btn-primary {
        background: #4ade80;
        border: none;
        color: #0a0a0a;
      }
      .btn-secondary {
        background: #171717;
        border: 1px solid #333;
        color: #d4d4d4;
      }
      .btn-retry {
        background: transparent;
        border: 1px solid #7f1d1d;
        color: #fca5a5;
        padding: 0.4rem 0.75rem;
      }

      a.btn-cancel {
        display: inline-block;
        padding: 0.55rem 1.1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        color: #a3a3a3;
        border: 1px solid #2a2a2a;
        transition: opacity 0.15s;
      }
      a.btn-cancel:hover { opacity: 0.8; }

      @media (max-width: 520px) {
        body { padding: 1.5rem 1rem; }
        .form-actions > button,
        .form-actions > .btn-cancel {
          text-align: center;
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/admin/posts" class="back-link">← Posts</a>
      <h1>New Post</h1>

      <div class="layout">
        <form method="POST" action="/admin/api/posts" class="form-section" data-new-post-form>
          <div class="field">
            <label for="title">Title</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              autocomplete="off"
              placeholder="Post title"
            />
          </div>

          <div class="field">
            <label for="slug">Slug</label>
            <input
              type="text"
              id="slug"
              name="slug"
              required
              autocomplete="off"
              placeholder="url-safe-slug"
            />
          </div>

          <PostEditor />

          <div class="save-state">
            <span
              class="save-status"
              data-post-save-status
              data-state="unsaved"
              aria-live="polite"
            >Waiting for a valid title, slug, and body</span>
            <button
              data-post-save-retry
              type="button"
              class="btn-retry"
              hidden
            >Retry save</button>
          </div>

          <div class="checkbox-row">
            <input type="checkbox" id="published" name="published" checked />
            <label for="published">Publish this post</label>
          </div>

          <div class="form-actions">
            <button data-post-save-draft type="button" class="btn-secondary">Save draft</button>
            <button type="submit" class="btn-primary">Publish</button>
            <a href="/admin/posts" class="btn-cancel">Cancel</a>
          </div>
        </form>

      </div>
    </div>

    <script>
      // Slug auto-generation from title.
      const form = document.querySelector('[data-new-post-form]');
      const titleInput = document.getElementById('title');
      const slugInput = document.getElementById('slug');

      let slugEdited = false;

      slugInput?.addEventListener('input', () => { slugEdited = true; });

      titleInput?.addEventListener('input', () => {
        if (!slugEdited && slugInput && titleInput instanceof HTMLInputElement) {
          slugInput.value = titleInput.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }
      });

      // PostEditor remains the sole save controller. It publishes the canonical
      // update target as form data after the create API accepts the first draft.
      // This projection makes the ordinary publish submit update that same post.
      if (form instanceof HTMLFormElement) {
        const projectCanonicalAction = () => {
          const canonicalAction = form.dataset.draftAction;
          if (canonicalAction) {
            form.action = canonicalAction;
          }
        };
        new MutationObserver(projectCanonicalAction).observe(form, {
          attributes: true,
          attributeFilter: ['data-draft-action'],
        });
        projectCanonicalAction();
      }
    </script>
  </body>
</html>
