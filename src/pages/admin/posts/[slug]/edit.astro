---
/**
 * src/pages/admin/posts/[slug]/edit.astro — Admin: edit an existing blog post.
 *
 * SSR page (prerender = false). Loads the post by slug, pre-fills the form,
 * and POSTs to /admin/api/posts/{slug} on submit. Redirects to /admin/posts
 * if the post does not exist (not found in KV).
 *
 * Client-side features match new.astro (rich-text editing, vanilla JS only).
 * Slug is displayed read-only — changing a slug would break existing URLs.
 *
 * @decision DEC-EDITOR-004
 * @title Platform rich-text editor, zero dependencies
 * @status accepted
 * @rationale See src/components/PostEditor.astro for full rationale.
 *   Slug field is read-only in the edit form: changing a slug would silently
 *   orphan the old KV key and break published URLs. A future rename feature
 *   can handle key migration explicitly.
 *
 * @decision DEC-BE-005
 * @title Latest editor snapshot controls save-state truth
 * @status accepted
 * @rationale The edit form supplies canonical fields and presentation controls
 *   to the shared PostEditor controller. Keeping autosave and explicit draft
 *   save there prevents this page from becoming a second persistence authority.
 */

export const prerender = false;

import { env as cloudflareEnv } from "cloudflare:workers";
import PostEditor from "../../../../components/PostEditor.astro";
import type { Env } from "../../../../lib/kv-store.ts";
import { getBlogPost, type BlogPost } from "../../../../lib/kv-store.ts";
import { validateStoredHtml } from "../../../../lib/html-policy.ts";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/admin/posts", 303);
}

const env = cloudflareEnv as Env;

let post: BlogPost | null = null;
try {
  post = await getBlogPost(env, slug);
} catch {
  return Astro.redirect("/admin/posts", 303);
}

if (post === null) {
  return Astro.redirect("/admin/posts", 303);
}

const storedBody = validateStoredHtml(post.body);
if (!storedBody.ok) {
  return new Response("Stored post body violates HTML policy", { status: 409 });
}

const actionUrl = `/admin/api/posts/${slug}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit: {post.title} — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: #0a0a0a;
        color: #e5e5e5;
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
        padding: 2.5rem 2rem;
      }

      .container { max-width: 1100px; margin: 0 auto; }

      .back-link {
        color: #6b6b6b;
        text-decoration: none;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-bottom: 1.5rem;
        transition: color 0.15s;
      }
      .back-link:hover { color: #e5e5e5; }

      h1 { font-size: 1.5rem; font-weight: 600; color: #f5f5f5; margin-bottom: 2rem; }

      .layout {
        display: block;
      }

      .form-section { display: flex; flex-direction: column; gap: 1.25rem; }

      .field { display: flex; flex-direction: column; gap: 0.4rem; }

      label {
        font-size: 0.75rem;
        font-weight: 500;
        color: #6b6b6b;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      input[type="text"] {
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        color: #e5e5e5;
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.6rem 0.8rem;
        width: 100%;
        transition: border-color 0.15s;
      }
      input[type="text"]:focus {
        outline: none;
        border-color: #4ade80;
      }

      input[readonly] {
        color: #6b6b6b;
        cursor: default;
      }

      .save-state {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem 0.9rem;
        min-height: 2.25rem;
      }

      .save-status {
        color: #737373;
        flex: 1 1 12rem;
        font-size: 0.8rem;
      }
      .save-status[data-state="saving"] { color: #facc15; }
      .save-status[data-state="saved"] { color: #4ade80; }
      .save-status[data-state="error"] { color: #f87171; }

      .form-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

      button {
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.55rem 1.1rem;
        transition: opacity 0.15s;
      }
      button:hover { opacity: 0.85; }
      button:focus-visible {
        outline: 2px solid #4ade80;
        outline-offset: 2px;
      }
      button:disabled { cursor: not-allowed; opacity: 0.55; }

      .btn-primary {
        background: #4ade80;
        border: none;
        color: #0a0a0a;
      }
      .btn-secondary {
        background: #171717;
        border: 1px solid #333;
        color: #d4d4d4;
      }
      .btn-retry {
        background: transparent;
        border: 1px solid #7f1d1d;
        color: #fca5a5;
        padding: 0.4rem 0.75rem;
      }

      a.btn-cancel {
        display: inline-block;
        padding: 0.55rem 1.1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        color: #a3a3a3;
        border: 1px solid #2a2a2a;
        transition: opacity 0.15s;
      }
      a.btn-cancel:hover { opacity: 0.8; }

      .meta-note {
        font-size: 0.75rem;
        color: #444;
        margin-top: 0.25rem;
      }

      @media (max-width: 520px) {
        body { padding: 1.5rem 1rem; }
        .form-actions > button,
        .form-actions > .btn-cancel {
          text-align: center;
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/admin/posts" class="back-link">← Posts</a>
      <h1>Edit Post</h1>

      <div class="layout">
        <form method="POST" action={actionUrl} class="form-section" data-edit-post-form>
          <div class="field">
            <label for="title">Title</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              autocomplete="off"
              value={post.title}
            />
          </div>

          <div class="field">
            <label for="slug">Slug</label>
            <input
              type="text"
              id="slug"
              name="slug"
              value={post.slug}
              readonly
              aria-readonly="true"
              title="Slug cannot be changed after creation"
            />
            <span class="meta-note">Slug is fixed after creation to preserve published URLs.</span>
          </div>

          <PostEditor initialBody={storedBody.value} />

          <div class="save-state">
            <span
              class="save-status"
              data-post-save-status
              data-state="saved"
              aria-live="polite"
            >Saved</span>
            <button
              data-post-save-retry
              type="button"
              class="btn-retry"
              hidden
            >Retry save</button>
          </div>

          <div class="form-actions">
            <button data-post-save-draft type="button" class="btn-secondary">Save draft</button>
            <button
              type="submit"
              class="btn-primary"
              name={post.published ? undefined : "published"}
              value={post.published ? undefined : "on"}
            >{post.published ? "Unpublish" : "Publish"}</button>
            <a href="/admin/posts" class="btn-cancel">Cancel</a>
          </div>
        </form>

      </div>
    </div>
  </body>
</html>
