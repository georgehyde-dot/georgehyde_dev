---
/** Immutable-id Project edit form. */
export const prerender = false;
import { env as cloudflareEnv } from "cloudflare:workers"; import type { Env } from "../../../../lib/kv-store.ts"; import { bootstrapSiteContent, getProject, type ProjectEntry } from "../../../../lib/site-content.ts";
const env = cloudflareEnv as Env; let project: ProjectEntry | null = null; try { await bootstrapSiteContent(env); project = await getProject(env, Astro.params.id); } catch { return Astro.redirect("/admin/projects",303); } if (!project) return Astro.redirect("/admin/projects",303);
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Edit Project — Admin</title><style>*,*::before,*::after{box-sizing:border-box}body{margin:0;min-height:100vh;padding:2.5rem 2rem;background:#0a0a0a;color:#e5e5e5;font-family:Inter,system-ui,sans-serif}main{width:min(760px,100%);margin:auto}a{color:#a3a3a3}form,.field{display:grid;gap:1rem}.field{gap:.4rem}label{color:#a3a3a3;font-size:.8rem;font-weight:600}input,textarea{width:100%;border:1px solid #333;border-radius:6px;background:#121212;color:#e5e5e5;font:inherit;padding:.7rem .8rem}input[readonly]{color:#737373}textarea{min-height:12rem;resize:vertical}.actions{display:flex;gap:.75rem;flex-wrap:wrap}button,.cancel{border:1px solid #333;border-radius:6px;padding:.6rem 1rem;text-decoration:none}button{background:#4ade80;border-color:#4ade80;color:#08120b;font-weight:700}@media(max-width:560px){body{padding:1.25rem 1rem}.actions>*{flex:1 1 100%;text-align:center}}</style></head><body><main><a href="/admin/projects">← Projects</a><h1>Edit Project</h1><form method="POST" action={`/admin/api/projects/${project.id}`}><div class="field"><label for="id">ID</label><input id="id" value={project.id} readonly aria-readonly="true" /></div><div class="field"><label for="title">Title</label><input id="title" name="title" maxlength="160" value={project.title} required /></div><div class="field"><label for="description">Description</label><textarea id="description" name="description" required>{project.description}</textarea></div><div class="field"><label for="url">Project URL (HTTPS)</label><input id="url" name="url" type="url" value={project.url} required /></div><div class="actions"><button type="submit">Save Project</button><a class="cancel" href="/admin/projects">Cancel</a></div></form></main></body></html>
