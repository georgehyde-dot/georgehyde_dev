---
/** Plain HTML Project creation form; server validation remains authoritative. */
export const prerender = false;
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>New Project — Admin</title><style>*,*::before,*::after{box-sizing:border-box}body{margin:0;min-height:100vh;padding:2.5rem 2rem;background:#0a0a0a;color:#e5e5e5;font-family:Inter,system-ui,sans-serif}main{width:min(760px,100%);margin:auto}a{color:#a3a3a3}form,.field{display:grid;gap:1rem}.field{gap:.4rem}label{color:#a3a3a3;font-size:.8rem;font-weight:600}input,textarea{width:100%;border:1px solid #333;border-radius:6px;background:#121212;color:#e5e5e5;font:inherit;padding:.7rem .8rem}textarea{min-height:12rem;resize:vertical}.actions{display:flex;gap:.75rem;flex-wrap:wrap}button,.cancel{border:1px solid #333;border-radius:6px;padding:.6rem 1rem;text-decoration:none}button{background:#4ade80;border-color:#4ade80;color:#08120b;font-weight:700}@media(max-width:560px){body{padding:1.25rem 1rem}.actions>*{flex:1 1 100%;text-align:center}}</style></head><body><main><a href="/admin/projects">← Projects</a><h1>New Project</h1><form method="POST" action="/admin/api/projects"><div class="field"><label for="id">ID</label><input id="id" name="id" required autocomplete="off" placeholder="url-safe-id" /></div><div class="field"><label for="title">Title</label><input id="title" name="title" maxlength="160" required /></div><div class="field"><label for="description">Description</label><textarea id="description" name="description" required></textarea></div><div class="field"><label for="url">Project URL (HTTPS)</label><input id="url" name="url" type="url" required /></div><div class="actions"><button type="submit">Create Project</button><a class="cancel" href="/admin/projects">Cancel</a></div></form></main></body></html>
