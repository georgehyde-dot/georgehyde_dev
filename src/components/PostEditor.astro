---
/**
 * src/components/PostEditor.astro — Shared admin rich-text post editor.
 *
 * Renders a dependency-free contenteditable editor, keeps the HTML body in a
 * hidden form field, and shows the same rendered preview the public page uses.
 *
 * @decision DEC-EDITOR-004
 * @title Platform rich-text editor, zero dependencies
 * @status accepted
 * @rationale The blog still stores HTML strings, but authors should not have
 *   to write HTML by hand. Browser editing primitives and a small vanilla JS
 *   toolbar provide common formatting without adding an npm editor dependency
 *   or changing the KV data model/API contract.
 *
 * @decision DEC-BE-005
 * @title Latest editor snapshot controls save-state truth
 * @status accepted
 * @rationale One controller serializes autosave and explicit draft saves so
 *   stale responses cannot clear newer dirty content or create a second client
 *   persistence authority.
 *
 * Future form contract (W-BE-1D/1E):
 * - The closest form supplies inputs named title, slug, and body plus its
 *   canonical create/update action.
 * - Optional presentation controls use data-post-save-status,
 *   data-post-save-retry, and data-post-save-draft.
 * - A Save draft control dispatches one bubbling post-editor:save-draft event
 *   on the form; this controller is the event's only save handler.
 * - Autosave sends _autosave=1 and Accept: application/json. A successful
 *   create response locks the slug input and changes later requests to the
 *   canonical /admin/api/posts/{slug} update action.
 */

interface Props {
  initialBody?: string;
}

const { initialBody = "" } = Astro.props;
---

<div class="editor-grid">
  <div class="field editor-field">
    <label for="body-editor">Body</label>
    <input type="hidden" id="body" name="body" value={initialBody} />

    <div class="editor-shell">
      <div class="editor-toolbar" aria-label="Post formatting toolbar">
        <button type="button" data-block="p" title="Paragraph" aria-label="Paragraph" aria-pressed="false">P</button>
        <button type="button" data-block="h2" title="Heading 2" aria-label="Heading 2" aria-pressed="false">H2</button>
        <button type="button" data-block="h3" title="Heading 3" aria-label="Heading 3" aria-pressed="false">H3</button>
        <span class="toolbar-divider" aria-hidden="true"></span>
        <button type="button" data-command="bold" title="Bold" aria-label="Bold" aria-pressed="false" aria-keyshortcuts="Control+B"><strong>B</strong></button>
        <button type="button" data-command="italic" title="Italic" aria-label="Italic" aria-pressed="false" aria-keyshortcuts="Control+I"><em>I</em></button>
        <button type="button" data-inline-code title="Inline code" aria-label="Inline code" aria-pressed="false">&lt;/&gt;</button>
        <button type="button" data-block="pre" title="Code block" aria-label="Code block" aria-pressed="false">Code</button>
        <button type="button" data-block="blockquote" title="Blockquote" aria-label="Blockquote" aria-pressed="false">"</button>
        <span class="toolbar-divider" aria-hidden="true"></span>
        <button type="button" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list" aria-pressed="false">*</button>
        <button type="button" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list" aria-pressed="false">1.</button>
        <button type="button" data-link title="Insert link" aria-label="Insert link">Link</button>
        <span class="toolbar-divider" aria-hidden="true"></span>
        <button type="button" data-command="undo" title="Undo" aria-label="Undo" disabled>Undo</button>
        <button type="button" data-command="redo" title="Redo" aria-label="Redo" disabled>Redo</button>
        <button type="button" data-command="removeFormat" title="Clear formatting" aria-label="Clear formatting">X</button>
      </div>

      <div
        id="body-editor"
        class="rich-editor"
        contenteditable="true"
        role="textbox"
        aria-label="Post body"
        aria-multiline="true"
        data-placeholder="Write your post..."
        set:html={initialBody}
      ></div>
    </div>
  </div>

  <div class="preview-panel">
    <div class="preview-label">Preview</div>
    <div class="preview-content" id="preview">
      <span class="preview-empty">Start typing to see a preview...</span>
    </div>
  </div>
</div>

<style>
  .editor-grid {
    align-items: start;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 768px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }
  }

  .editor-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .editor-field label {
    color: #6b6b6b;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .editor-shell {
    background: #111;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .editor-shell:focus-within {
    border-color: #4ade80;
  }

  .editor-toolbar {
    align-items: center;
    background: #0f0f0f;
    border-bottom: 1px solid #252525;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.45rem;
  }

  .editor-toolbar button {
    align-items: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #a3a3a3;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    height: 1.85rem;
    justify-content: center;
    min-width: 1.85rem;
    padding: 0 0.45rem;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .editor-toolbar button:hover,
  .editor-toolbar button:focus-visible {
    background: #1a1a1a;
    border-color: #333;
    color: #e5e5e5;
    outline: none;
  }

  .editor-toolbar button[aria-pressed="true"] {
    background: #16351f;
    border-color: #4ade80;
    color: #dcfce7;
  }

  .editor-toolbar button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .toolbar-divider {
    background: #2a2a2a;
    height: 1.25rem;
    margin: 0 0.2rem;
    width: 1px;
  }

  .rich-editor {
    color: #e5e5e5;
    font-size: 0.95rem;
    line-height: 1.7;
    min-height: 360px;
    outline: none;
    overflow-wrap: anywhere;
    padding: 0.85rem 1rem;
  }

  .rich-editor:empty::before {
    color: #555;
    content: attr(data-placeholder);
    pointer-events: none;
  }

  .rich-editor :global(h2) {
    color: #f4f4f5;
    font-size: 1.3rem;
    font-weight: 600;
    margin: 1.2rem 0 0.45rem;
  }

  .rich-editor :global(h3) {
    color: #f4f4f5;
    font-size: 1.08rem;
    font-weight: 600;
    margin: 1rem 0 0.35rem;
  }

  .rich-editor :global(p),
  .rich-editor :global(ul),
  .rich-editor :global(ol),
  .rich-editor :global(blockquote) {
    margin-bottom: 0.9rem;
  }

  .rich-editor :global(code) {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    font-family: ui-monospace, monospace;
    padding: 0.1em 0.35em;
  }

  .rich-editor :global(pre) {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    overflow-x: auto;
    padding: 0.9rem 1.1rem;
    white-space: pre-wrap;
  }

  .rich-editor :global(ul),
  .rich-editor :global(ol) {
    padding-left: 1.4rem;
  }

  .rich-editor :global(blockquote) {
    border-left: 3px solid #4ade80;
    color: #cfcfcf;
    padding-left: 0.9rem;
  }

  .preview-panel {
    background: #0f0f0f;
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    min-height: 400px;
    padding: 1.5rem;
  }

  .preview-label {
    color: #444;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .preview-content {
    color: #d4d4d4;
    font-size: 0.95rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .preview-content :global(h2) {
    color: #f4f4f5;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }

  .preview-content :global(h3) {
    color: #f4f4f5;
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1rem 0 0.4rem;
  }

  .preview-content :global(p),
  .preview-content :global(ul),
  .preview-content :global(ol),
  .preview-content :global(blockquote) {
    margin-bottom: 1rem;
  }

  .preview-content :global(ul),
  .preview-content :global(ol) {
    padding-left: 1.4rem;
  }

  .preview-content :global(blockquote) {
    border-left: 3px solid #4ade80;
    color: #cfcfcf;
    padding-left: 0.9rem;
  }

  .preview-content :global(a) {
    color: #4ade80;
  }

  .preview-content :global(code) {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    padding: 0.1em 0.35em;
  }

  .preview-content :global(pre) {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    margin-bottom: 1rem;
    overflow-x: auto;
    padding: 0.9rem 1.1rem;
  }

  .preview-empty {
    color: #333;
    font-size: 0.875rem;
    font-style: italic;
  }
</style>

<script>
  const editor = document.getElementById('body-editor');
  const bodyInput = document.querySelector('input[name="body"]');
  const preview = document.getElementById('preview');
  const form = editor?.closest('form');

  const AUTOSAVE_DELAY_MS = 750;
  const emptyPreview = '<span class="preview-empty">Start typing to see a preview...</span>';
  const allowedLinkProtocols = new Set(['http:', 'https:', 'mailto:']);

  /* SAVE_CONTROLLER_START */
  function createSaveController(options) {
    const state = {
      canonicalSlug: options.initialSlug || null,
      dirty: false,
      status: 'saved',
    };
    let action = options.initialAction;
    let changeVersion = 0;
    let timer = null;
    let inFlight = false;
    let followUp = false;

    const publish = (status, extra = {}) => {
      Object.assign(state, { status, ...extra });
      options.onState({ ...state });
    };

    const clearPendingTimer = () => {
      if (timer !== null) {
        options.clearTimer(timer);
        timer = null;
      }
    };

    const run = () => {
      clearPendingTimer();
      if (inFlight) {
        followUp = true;
        return;
      }

      const snapshot = options.getSnapshot();
      if (!snapshot) {
        publish('unsaved', { dirty: true });
        return;
      }

      const requestVersion = changeVersion;
      inFlight = true;
      followUp = false;
      publish('saving', { dirty: true });

      Promise.resolve(options.request({ action, snapshot }))
        .then((result) => {
          if (!result || result.ok !== true) {
            throw new Error(result?.error?.message || 'Draft could not be saved');
          }

          const responseSlug = result.post?.slug;
          if (!state.canonicalSlug && responseSlug) {
            state.canonicalSlug = responseSlug;
            action = `/admin/api/posts/${encodeURIComponent(responseSlug)}`;
            options.onCanonicalSlug?.(responseSlug, action);
          }

          inFlight = false;
          if (followUp || changeVersion !== requestVersion) {
            publish('unsaved', { dirty: true });
            run();
          } else {
            publish('saved', { dirty: false });
          }
        })
        .catch((error) => {
          inFlight = false;
          followUp = false;
          publish('error', {
            dirty: true,
            message: error instanceof Error ? error.message : 'Draft could not be saved',
          });
        });
    };

    return {
      changed() {
        changeVersion += 1;
        publish('unsaved', { dirty: true, message: '' });
        clearPendingTimer();
        if (inFlight) {
          followUp = true;
        } else {
          timer = options.setTimer(run, options.delay);
        }
      },
      getState() {
        return { ...state };
      },
      retry() {
        run();
      },
      saveNow() {
        changeVersion += 1;
        publish('unsaved', { dirty: true, message: '' });
        run();
      },
    };
  }
  /* SAVE_CONTROLLER_END */

  const escapeHtml = (value) => value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

  const textToParagraphHtml = (value) => value
    .trim()
    .split(/\n{2,}/)
    .map((paragraph) => paragraph
      .split(/\n/)
      .map((line) => escapeHtml(line))
      .join('<br>'))
    .filter(Boolean)
    .map((paragraph) => `<p>${paragraph}</p>`)
    .join('');

  const normalizeLinkHref = (value) => {
    const href = value.trim();
    if (!href) {
      return null;
    }

    if (href.startsWith('/') || href.startsWith('#')) {
      return href;
    }

    try {
      const url = new URL(href, window.location.origin);
      return allowedLinkProtocols.has(url.protocol) ? url.href : null;
    } catch {
      return null;
    }
  };

  const syncBody = () => {
    if (!(editor instanceof HTMLElement) || !(bodyInput instanceof HTMLInputElement)) {
      return;
    }

    const html = editor.innerHTML.trim();
    bodyInput.value = html;
    if (preview) {
      preview.innerHTML = html || emptyPreview;
    }
  };

  const getFormControl = (name) => form?.querySelector(`[name="${name}"]`);
  const statusControl = form?.querySelector('[data-post-save-status]');
  const retryControl = form?.querySelector('[data-post-save-retry]');
  const saveDraftControl = form?.querySelector('[data-post-save-draft]');

  const snapshotForm = () => {
    syncBody();
    const title = getFormControl('title');
    const slug = getFormControl('slug');
    if (!(title instanceof HTMLInputElement) ||
        !(slug instanceof HTMLInputElement) ||
        !(bodyInput instanceof HTMLInputElement) ||
        !title.value.trim() ||
        !slug.value.trim() ||
        !bodyInput.value.trim()) {
      return null;
    }
    return { title: title.value, slug: slug.value, body: bodyInput.value };
  };

  const requestSave = async ({ action, snapshot }) => {
    const data = new FormData();
    data.set('title', snapshot.title);
    data.set('slug', snapshot.slug);
    data.set('body', snapshot.body);
    data.set('_autosave', '1');
    const response = await fetch(action, {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: data,
    });
    const result = await response.json().catch(() => ({
      ok: false,
      error: { message: `Draft save failed (${response.status})` },
    }));
    if (!response.ok || result.ok !== true) {
      throw new Error(result.error?.message || `Draft save failed (${response.status})`);
    }
    return result;
  };

  const renderSaveState = (state) => {
    if (statusControl instanceof HTMLElement) {
      const labels = {
        unsaved: 'Unsaved changes',
        saving: 'Saving…',
        saved: 'Saved',
        error: state.message || 'Draft could not be saved',
      };
      statusControl.textContent = labels[state.status] || 'Unsaved changes';
      statusControl.dataset.state = state.status;
      statusControl.setAttribute('role', state.status === 'error' ? 'alert' : 'status');
    }
    if (retryControl instanceof HTMLButtonElement) {
      retryControl.hidden = state.status !== 'error';
    }
  };

  const initialAction = form?.getAttribute('action') || '/admin/api/posts';
  const saveController = createSaveController({
    delay: AUTOSAVE_DELAY_MS,
    getSnapshot: snapshotForm,
    request: requestSave,
    setTimer: window.setTimeout.bind(window),
    clearTimer: window.clearTimeout.bind(window),
    onState: renderSaveState,
    initialAction,
    onCanonicalSlug: (slug, action) => {
      const slugControl = getFormControl('slug');
      if (slugControl instanceof HTMLInputElement) {
        slugControl.value = slug;
        slugControl.readOnly = true;
        slugControl.setAttribute('aria-readonly', 'true');
      }
      form?.setAttribute('data-draft-action', action);
    },
  });

  const focusEditor = () => {
    if (editor instanceof HTMLElement) {
      editor.focus();
    }
  };

  const updateToolbarState = () => {
    if (!(editor instanceof HTMLElement)) {
      return;
    }
    const selection = document.getSelection();
    const anchor = selection?.anchorNode;
    if (!anchor || !editor.contains(anchor)) {
      return;
    }

    document.querySelectorAll('[data-command][aria-pressed]').forEach((button) => {
      if (button instanceof HTMLButtonElement && button.dataset.command) {
        button.setAttribute('aria-pressed', String(document.queryCommandState(button.dataset.command)));
      }
    });
    document.querySelectorAll('[data-block]').forEach((button) => {
      if (button instanceof HTMLButtonElement) {
        const element = anchor instanceof Element ? anchor : anchor.parentElement;
        button.setAttribute('aria-pressed', String(element?.closest(button.dataset.block) !== null));
      }
    });
    const inlineCode = document.querySelector('[data-inline-code]');
    if (inlineCode instanceof HTMLButtonElement) {
      const element = anchor instanceof Element ? anchor : anchor.parentElement;
      inlineCode.setAttribute('aria-pressed', String(element?.closest('code') !== null));
    }
    for (const command of ['undo', 'redo']) {
      const button = document.querySelector(`[data-command="${command}"]`);
      if (button instanceof HTMLButtonElement) {
        button.disabled = !document.queryCommandEnabled(command);
      }
    }
  };

  const toggleInlineCode = () => {
    const selection = document.getSelection();
    if (!selection?.rangeCount || !(editor instanceof HTMLElement)) {
      return;
    }
    const range = selection.getRangeAt(0);
    const anchor = selection.anchorNode;
    const activeCode = (anchor instanceof Element ? anchor : anchor?.parentElement)?.closest('code');

    if (activeCode instanceof HTMLElement && editor.contains(activeCode)) {
      if (selection.isCollapsed) {
        range.setStartAfter(activeCode);
        range.collapse(true);
        selection.removeAllRanges();
        selection.addRange(range);
        return;
      }

      activeCode.replaceWith(...activeCode.childNodes);
      return;
    }

    if (selection.isCollapsed) {
      return;
    }

    const contents = range.extractContents();
    contents.querySelectorAll('code').forEach((nestedCode) => {
      nestedCode.replaceWith(...nestedCode.childNodes);
    });
    const code = document.createElement('code');
    code.append(contents);
    range.insertNode(code);
    selection.removeAllRanges();
    selection.selectAllChildren(code);
  };

  const selectedStandaloneBlock = (tagName) => {
    if (!(editor instanceof HTMLElement)) {
      return null;
    }
    const anchor = document.getSelection()?.anchorNode;
    let block = (anchor instanceof Element ? anchor : anchor?.parentElement)?.closest(tagName);
    if (!(block instanceof HTMLElement) || !editor.contains(block)) {
      return null;
    }
    while (block.parentElement?.closest(tagName) instanceof HTMLElement) {
      block = block.parentElement.closest(tagName);
    }
    return block;
  };

  const paragraphAfter = (block) => {
    if (block.nextElementSibling instanceof HTMLParagraphElement) {
      return block.nextElementSibling;
    }
    const paragraph = document.createElement('p');
    paragraph.append(document.createElement('br'));
    block.after(paragraph);
    return paragraph;
  };

  const placeCaretAtStart = (element) => {
    const selection = document.getSelection();
    if (!selection) {
      return;
    }
    const range = document.createRange();
    range.selectNodeContents(element);
    range.collapse(true);
    selection.removeAllRanges();
    selection.addRange(range);
  };

  const toggleStandaloneBlock = (tagName) => {
    const activeBlock = selectedStandaloneBlock(tagName);
    if (activeBlock) {
      placeCaretAtStart(paragraphAfter(activeBlock));
      return;
    }

    document.execCommand('formatBlock', false, tagName);
    const createdBlock = selectedStandaloneBlock(tagName);
    if (createdBlock) {
      paragraphAfter(createdBlock);
    }
  };

  document.querySelectorAll('[data-command], [data-block], [data-inline-code], [data-link]').forEach((button) => {
    button.addEventListener('mousedown', (event) => {
      event.preventDefault();
    });

    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      focusEditor();

      const block = button.dataset.block;
      const command = button.dataset.command;

      if (block === 'pre' || block === 'blockquote') {
        toggleStandaloneBlock(block);
      } else if (block) {
        document.execCommand('formatBlock', false, block);
      } else if (button.hasAttribute('data-inline-code')) {
        toggleInlineCode();
      } else if (button.hasAttribute('data-link')) {
        const href = window.prompt('URL');
        if (href !== null) {
          const safeHref = normalizeLinkHref(href);
          if (safeHref) {
            document.execCommand('createLink', false, safeHref);
          } else {
            window.alert('Use a relative URL, http(s), or mailto link.');
          }
        }
      } else if (command) {
        document.execCommand(command, false, button.dataset.value ?? '');
      }

      syncBody();
      saveController.changed();
      updateToolbarState();
    });
  });

  editor?.addEventListener('input', () => {
    syncBody();
    saveController.changed();
    updateToolbarState();
  });
  editor?.addEventListener('paste', (event) => {
    if (!(editor instanceof HTMLElement)) {
      return;
    }

    const text = event.clipboardData?.getData('text/plain') ?? '';
    event.preventDefault();
    if (!text.trim()) {
      return;
    }

    document.execCommand('insertHTML', false, textToParagraphHtml(text));
    syncBody();
    saveController.changed();
  });
  editor?.addEventListener('blur', syncBody);
  form?.querySelectorAll('input[name="title"], input[name="slug"]').forEach((control) => {
    control.addEventListener('input', () => saveController.changed());
  });
  form?.addEventListener('post-editor:save-draft', (event) => {
    event.preventDefault();
    saveController.saveNow();
  });
  retryControl?.addEventListener('click', () => saveController.retry());
  saveDraftControl?.addEventListener('click', () => {
    form?.dispatchEvent(new CustomEvent('post-editor:save-draft', { bubbles: true }));
  });
  document.addEventListener('selectionchange', updateToolbarState);
  form?.addEventListener('submit', () => {
    syncBody();
    window.setTimeout(() => {
      form.querySelectorAll('button[type="submit"]').forEach((button) => {
        if (button instanceof HTMLButtonElement) {
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
        }
      });
    }, 0);
  });
  syncBody();
  renderSaveState(saveController.getState());
  updateToolbarState();
</script>
